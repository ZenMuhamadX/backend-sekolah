generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum SiswaStatus {
  ACTIVE
  DELETED
}

enum Role {
  ADMIN
  USER
}

enum JenisKelamin {
  L
  P
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  nama      String   @db.VarChar(150)
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Siswa {
  id Int @id @default(autoincrement())

  // Data utama siswa
  no              Int?
  nama            String  @db.VarChar(150)
  nipd            String? @db.VarChar(50)
  jk              JenisKelamin?
  nisn            String? @unique @db.VarChar(20)
  tempatLahir     String? @db.VarChar(100)
  tanggalLahir    DateTime?
  nik             String? @unique @db.VarChar(20)
  agama           String? @db.VarChar(50)
  alamat          String? @db.Text
  rt              String? @db.VarChar(10)
  rw              String? @db.VarChar(10)
  dusun           String? @db.VarChar(100)
  kelurahan       String? @db.VarChar(100)
  kecamatan       String? @db.VarChar(100)
  kodePos         String? @db.VarChar(10)
  jenisTinggal    String? @db.VarChar(100)
  alatTransportasi String? @db.VarChar(100)
  hp              String? @db.VarChar(30)

  // Data ayah
  ayahNama               String? @db.VarChar(150)
  ayahTahunLahir         Int?
  ayahJenjangPendidikan  String? @db.VarChar(100)
  ayahPekerjaan          String? @db.VarChar(100)
  ayahPenghasilan        String? @db.VarChar(100)
  ayahNik                String? @db.VarChar(20)

  // Data ibu
  ibuNama               String? @db.VarChar(150)
  ibuTahunLahir         Int?
  ibuJenjangPendidikan  String? @db.VarChar(100)
  ibuPekerjaan          String? @db.VarChar(100)
  ibuPenghasilan        String? @db.VarChar(100)
  ibuNik                String? @db.VarChar(20)

  // Data sekolah / administrasi
  rombelSaatIni          String? @db.VarChar(100)
  noRegistrasiAktaLahir  String? @db.VarChar(100)
  anakKeberapa           Int?
  kip                    String? @db.VarChar(100)

  // File dokumen, sementara monolith dulu
  fileKk          String? @db.VarChar(255)
  fileAkta        String? @db.VarChar(255)
  fileKtpAyah     String? @db.VarChar(255)
  fileKtpIbu      String? @db.VarChar(255)
  fileKip         String? @db.VarChar(255)
  fileLainnya     String? @db.VarChar(255)

  // Metadata
  status SiswaStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([nama])
  @@index([rombelSaatIni])
  @@index([nisn])
  @@index([nik])
  @@map("siswa")
}